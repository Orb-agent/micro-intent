# Google Gemini API Key and Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud OAuth client of type Web application (public client ID, not a secret).
# Falls back to GOOGLE_CLIENT_ID in the repository root .env if omitted here.
# Add http://localhost:8000 to the client's Authorized JavaScript origins.
# Enable Gmail API / Google Calendar API and add your account as an OAuth test user.
GOOGLE_CLIENT_ID=

# Optional: Google Maps Platform API Key (for Places & Directions API).
# If omitted, official Google Maps deep links and resilient fallback resolvers are used automatically.
GOOGLE_MAPS_API_KEY=

# Optional: SerpApi Key for live Google Flights scraping/engine.
# If omitted, Google Flights query URLs and structured flight scheduling are used.
SERPAPI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
