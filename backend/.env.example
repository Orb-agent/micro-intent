# Copy to backend/.env (or the repo-root .env); never commit the real file.
APP_TOKEN=change-me-to-a-long-random-string

# Gemini and Gradium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# Google Workspace OAuth: a Web client in the Cloud project, and a refresh token for the
# temporary account from the OAuth Playground with these read-only scopes:
#   calendar.readonly gmail.readonly tasks.readonly drive.readonly
# The Calendar, Gmail, Tasks and Drive APIs must be enabled in the client's project.
# With WORKSPACE_MODE=rest and all three set, the agent also gets the live Calendar, Gmail,
# Tasks and Drive tools; otherwise it has the preloaded context only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WORKSPACE_MODE=fixture
MOCK_AGENT=1

# Optional: Maps tools for the agent. Enable Places API (New) and Routes API on the key
# and restrict it to those two. Without it, the agent has no Maps tools.
GOOGLE_MAPS_API_KEY=

# Optional: live Google Flights results through SerpApi (serpapi.com). Without it,
# flights_search only gives a prefilled Google Flights link.
SERPAPI_API_KEY=
