# Copy to backend/.env (or the repo-root .env); never commit the real file.
APP_TOKEN=change-me-to-a-long-random-string

# Gemini and Gradium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WORKSPACE_MODE=fixture
MOCK_AGENT=1
# 1: the agent speaks up on its own about a new screenshot; 0: only when asked
PROACTIVE_SCREEN=1

# Optional: Maps tools for the agent. Enable Places API (New) and Routes API on the key
# and restrict it to those two. Without it, the agent has no Maps tools.
GOOGLE_MAPS_API_KEY=
