# Copy to backend/.env (or the repo-root .env); never commit the real file.
APP_TOKEN=change-me-to-a-long-random-string

# Gemini and voice services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WORKSPACE_MODE=fixture
MOCK_AGENT=1

# Optional: Google Maps Platform API key for Places and Directions.
GOOGLE_MAPS_API_KEY=

# Optional: SerpApi key for live Google Flights search.
SERPAPI_API_KEY=

# Server configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
