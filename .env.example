# Copy to backend/.env (gitignored) or export in your shell. Never commit real values.

# Gemini (Google AI Studio key) - used by the backend only, never shipped in the extension.
GEMINI_API_KEY=
# Google Cloud project for deploys and Calendar API.
GOOGLE_CLOUD_PROJECT=agentic26zrh-2067

# Agent model (Interactions API with function calling).
MICRO_INTENT_MODEL=gemini-3.8-flash
# Live model handed out via ephemeral tokens for voice input.
MICRO_INTENT_LIVE_MODEL=gemini-3.8-live

# Calendar source: "mock" (default, planted "Team sync 18:00-18:30" conflict) or "google".
CALENDAR_SOURCE=mock
# Path to an OAuth token JSON for the Google Calendar API (only when CALENDAR_SOURCE=google).
GOOGLE_CALENDAR_TOKEN_FILE=
# Calendar id for the Google source (default: primary).
GOOGLE_CALENDAR_ID=primary

# Force the scripted demo path without calling Gemini or SBB (e.g. offline rehearsal).
MICRO_INTENT_FORCE_FALLBACK=false

# Timezone used for "today", free/busy and card times.
MICRO_INTENT_TZ=Europe/Zurich
