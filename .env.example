# Optional local backend configuration. Never commit real credentials.
PORT=3001
HOST=127.0.0.1
# Optional HTTPS reverse-proxy origin(s), comma-separated, for remote/mobile access.
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
# Gemini 3.5 Flash-Lite is the default compact model; override as needed.
GEMINI_MODEL=gemini-3.5-flash-lite
